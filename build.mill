object Versions:
  val scala          = "3.8.3"
  val munit          = "1.1.0"
  val scalaJs        = "1.21.0"
  val scalaNative    = "0.5.11"
  val scalaJavaTime  = "2.6.0"
  val previous       = "0.4.0"
  val previousMacros = "0.4.0"

trait ScalaObjectNotationModule extends SbtModule:
  def scalaVersion = Versions.scala

  object test extends SbtTests with TestModule.Munit:
    override def munitVersion   = Versions.munit
    override def forkArgs       = super.forkArgs() ++ Seq("-Xss4m")
    override def sourcesFolders =
      // TODO: reorganize modules to benefit from SbtPlatformModule automatic source folder names?
      super.sourcesFolders.flatMap(p => Seq(p, os.sub / "jvm-native" / p))

trait ScalaObjectNotationPlatformModule extends SbtPlatformModule:
  def scalaVersion = Versions.scala

trait ScalaObjectNotationJsModule extends ScalaObjectNotationPlatformModule, ScalaJSModule:
  def scalaJSVersion = Versions.scalaJs

  object test extends ScalaJSTests with SbtPlatformTests with TestModule.Munit:
    override def munitVersion = Versions.munit

    override def mvnDeps: Simple[Seq[Dep]] = super.mvnDeps() ++ Seq(
      mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}"
    )

trait ScalaObjectNotationJsWasmModule extends ScalaObjectNotationJsModule:
  override def platformCrossSuffix = "js"

  override def jsEnvConfig: T[JsEnvConfig] = Task {
    JsEnvConfig.NodeJs(
      args = List(
        // "--experimental-wasm-exnref",
        // "--experimental-wasm-imported-strings"
      )
    )
  }

  override def moduleKind: T[ModuleKind]             = Task { ModuleKind.ESModule }
  override def moduleSplitStyle: T[ModuleSplitStyle] = Task { ModuleSplitStyle.FewestModules }
  override def scalaJSExperimentalUseWebAssembly: T[Boolean] = Task { true }

trait ScalaObjectNotationNativeModule extends ScalaObjectNotationPlatformModule, ScalaNativeModule:
  def scalaNativeVersion = Versions.scalaNative

  object test extends ScalaNativeTests with SbtPlatformTests with TestModule.Munit:
    override def munitVersion = Versions.munit

    override def mvnDeps: Simple[Seq[Dep]] = super.mvnDeps() ++ Seq(
      mvn"io.github.cquiroz::scala-java-time::${Versions.scalaJavaTime}"
    )

trait CoreModuleBase extends ScalaModule:
  def artifactName = "scala-object-notation"

  override def mvnDeps: Simple[Seq[Dep]] = super.mvnDeps() ++ Seq(
    mvn"ch.epfl.lamp::steps::0.2.1"
  )

trait PublishSettings extends PublishModule, mill.util.VcsVersionModule:
  def projectDesc: String

  def pomSettings = PomSettings(
    description = projectDesc,
    organization = "io.github.bishabosha",
    url = "https://github.com/bishabosha/scala-object-notation",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("bishabosha", "scala-object-notation"),
    developers = Seq(
      Developer(
        "bishabosha",
        "Jamie Thompson",
        "https://bishabosha.github.io",
        email = "thompsonjamesrichard@gmail.com"
      )
    )
  )

trait CorePublishedModule extends CoreModuleBase, PublishSettings:
  def projectDesc = "parser for a subset of Scala syntax for interpreting directly to data"

object core extends ScalaObjectNotationModule, CorePublishedModule, Mima, TastyMimaModule:
  override def mimaPreviousVersions: T[Seq[String]] = Task {
    Seq(Versions.previous)
  }

  override def tastyMimaArtifactPrivatePackages: T[Seq[String]] = Task {
    Seq("scalanotation.internal")
  }

  override def tastyMimaProblemFilters: Seq[tastymima.intf.ProblemMatcher] = Seq(
    // the internal token-based named-tuple structure helpers (and their synthetic inline
    // accessors) were replaced by the kernel record loop; BaseDecoders is private[scalanotation]
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.MissingTermMember,
      "scalanotation.internal.BaseDecoders.*"
    ),
    // the None-fill walk generalized to the fills array (fillSkippedFields); PushSlots is
    // private[scalanotation]
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.MissingTermMember,
      "scalanotation.internal.PushSlots.fillSkippedNullableFields"
    ),
    // the plain-function total-map constructors are superseded by Writer typed-map overloads and
    // hidden from source so lambda arguments resolve to the typed variants; they stay public in
    // binary via @publicInBinary, so the visibility restriction cannot break compiled callers
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.RestrictedVisibilityChange,
      "scalanotation.schema.RawSchema.mapIntTotalAndInput"
    ),
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.RestrictedVisibilityChange,
      "scalanotation.schema.RawSchema.mapLongTotalAndInput"
    ),
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.RestrictedVisibilityChange,
      "scalanotation.schema.RawSchema.mapFloatTotalAndInput"
    ),
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.RestrictedVisibilityChange,
      "scalanotation.schema.RawSchema.mapDoubleTotalAndInput"
    ),
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.RestrictedVisibilityChange,
      "scalanotation.ReadWriter.int"
    ),
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.RestrictedVisibilityChange,
      "scalanotation.ReadWriter.long"
    ),
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.RestrictedVisibilityChange,
      "scalanotation.ReadWriter.float"
    ),
    tastymima.intf.ProblemMatcher.make(
      tastymima.intf.ProblemKind.RestrictedVisibilityChange,
      "scalanotation.ReadWriter.double"
    )
  )

  object js     extends ScalaObjectNotationJsModule, CorePublishedModule
  object jsWasm extends ScalaObjectNotationJsWasmModule, CoreModuleBase
  object native extends ScalaObjectNotationNativeModule, CorePublishedModule

trait MacrosBase extends ScalaModule:
  def artifactName = "scala-object-notation-macros"

trait MacrosPublishedModule extends MacrosBase, PublishSettings:
  def projectDesc = "macro derivation of typed factories for scala-object-notation"

object macros extends ScalaObjectNotationModule, MacrosPublishedModule, Mima, TastyMimaModule:
  override def mimaPreviousVersions: T[Seq[String]] = Task {
    Seq(Versions.previousMacros)
  }
  def moduleDeps = Seq(core)

  object js extends ScalaObjectNotationJsModule, MacrosPublishedModule:
    def moduleDeps = Seq(core.js)
  object jsWasm extends ScalaObjectNotationJsWasmModule, MacrosBase:
    def moduleDeps = Seq(core.jsWasm)
  object native extends ScalaObjectNotationNativeModule, MacrosPublishedModule:
    def moduleDeps = Seq(core.native)

object demo extends ScalaObjectNotationModule:
  def artifactName = "scala-object-notation-config"
  def moduleDeps   = Seq(core)

  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"com.lihaoyi::upickle:4.3.2",
    mvn"com.lihaoyi::ujson:4.3.2",
    mvn"org.virtuslab::scala-yaml:0.3.1"
  )

  def mainClass = Some("scalableconfig.Main")

val benchTestVersions = Seq("HEAD", "0.4.3", "0.4.2", "0.4.1", "0.4.0", "0.3.7", "0.3.6", "0.3.5")
case class BenchTestVersion(version: String):
  def displayName: String = version match
    case "HEAD"              => "head"
    case s"$maj.$min.$patch" => s"$version+"

given Ordering[BenchTestVersion]:
  def compare(x: BenchTestVersion, y: BenchTestVersion): Int = (x, y) match
    case (BenchTestVersion(x0), BenchTestVersion(y0)) if x0 == y0                             => 0
    case (BenchTestVersion("HEAD"), _)                                                        => 1
    case (_, BenchTestVersion("HEAD"))                                                        => -1
    case (BenchTestVersion(s"$majX.$minX.$patchX"), BenchTestVersion(s"$majY.$minY.$patchY")) =>
      (majX.toInt, minX.toInt, patchX.toInt).compare((majY.toInt, minY.toInt, patchY.toInt))
    case (BenchTestVersion(str0), BenchTestVersion(str1)) => str0.compare(str1)

object bench      extends Cross[BenchModule](benchTestVersions)
trait BenchModule extends Cross.Module[String], ScalaObjectNotationModule, JmhModule:
  def jmhCoreVersion = "1.37"
  // HEAD additionally gets the macros module, for benchmarks of macro-derived typed factories

  val crossVersion = BenchTestVersion(crossValue)

  override def moduleDeps =
    if crossValue == "HEAD" then Seq(core, macros) else Seq.empty
  override def mvnDeps = super.mvnDeps() ++ (
    if crossValue == "HEAD" then
      // comparison baselines for the HEAD benchmarks: JSON decoding via jsoniter-scala,
      // uPickle, and zio-blocks
      Seq(
        mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-core::2.35.3",
        mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros::2.35.3",
        mvn"com.lihaoyi::upickle::4.4.3",
        mvn"dev.zio::zio-blocks-schema::0.017"
      )
    else
      val macroDep = {
        if crossVersion >= BenchTestVersion("0.3.7") then
          Seq(mvn"io.github.bishabosha::scala-object-notation-macros::${crossValue}")
        else Seq.empty
      }
      Seq(mvn"io.github.bishabosha::scala-object-notation::${crossValue}") ++ macroDep
  )
  def versionDirNames: Seq[String] =
    benchTestVersions.map(BenchTestVersion(_)).filter(v => v <= crossVersion).map(_.displayName)
  def versionSources =
    Task.Sources(versionDirNames.map(dir => moduleDir / s"src-$dir" / "main" / "scala")*)
  override def sources = Task {
    super.sources() ++ versionSources()
  }
  def runJmhMem(args: String*)    = runJmh(("-prof" +: "gc" +: args.toSeq)*)
  def runJmhMemJit(args: String*) = runJmh(
    (
      Seq(
        "-prof",
        "gc",
        "-prof",
        "comp",
        "-wi",
        "15",
        "-w",
        "2s",
        "-i",
        "15",
        "-r",
        "2s",
        "-f",
        "3",
        "-foe",
        "true",
        "-v",
        "EXTRA"
      ) ++ args.toSeq
    )*
  )
